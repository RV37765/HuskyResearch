<launch>
  <!--
    Real Robot Navigation Launch File
    Localizes on a saved field map and navigates to goals.

    Prerequisites:
      - real_crop_map.yaml + real_crop_map.pgm must exist in maps/
        (generate with husky_real_slam.launch first, then map_saver)
      - Husky powered on, e-stop released, base drivers running
      - VLP-16 publishing at ~10 Hz (rostopic hz /velodyne_points)
      - This launch file runs ON THE ROBOT (x86 PC) over SSH

    Usage:
      1. SSH into Jetson:  ssh administrator@<robot_ip>
      2. roslaunch husky_custom_sim husky_real_nav.launch
      3. Open RViz on your laptop
      4. Wait for AMCL particle cloud to converge (~5-15 seconds)
         If particles don't converge: use "2D Pose Estimate" in RViz to
         manually click the robot's current location on the map
      5. Click "2D Nav Goal" in RViz, click a point inside an aisle
      6. Watch terminal for: [move_base] Goal reached!

    Differences from simulation launch:
      - No Gazebo, no spawn_husky, no controller_respawner
      - No static TF for velodyne (URDF handles it)
      - cmd_vel goes through twist_mux (do NOT bypass — safety is active)
      - use_sim_time = false (real clock)
      - Loads real_crop_map instead of crop_map
      - AMCL initial_pose not hardcoded — robot may be anywhere in field
  -->

  <param name="/use_sim_time" value="false"/>

  <!-- pointcloud_to_laserscan is NOT started here.
       husky_bringup (auto-starts on boot) already converts /velodyne_points
       to /scan via velodyne_nodelet_manager. Running a second converter would
       create two competing publishers on /scan — same issue as Day 1 of SLAM. -->

  <!-- scan_relay: corrects VLP-16 /scan header mismatch before AMCL sees it.
       The VLP-16 firmware sends 897 readings but the header implies 898.
       AMCL uses the same scan validation as slam_toolbox — needs /scan_fixed. -->
  <node pkg="husky_custom_sim" type="scan_relay.py" name="scan_relay" output="screen"
        respawn="true" respawn_delay="2.0"/>

  <!-- Load the saved real field map.
       If map file not found, AMCL and move_base will fail silently.
       Verify path is correct before launching. -->
  <node pkg="map_server" type="map_server" name="map_server"
        args="$(find husky_custom_sim)/maps/hallway_strip.yaml"/>



  <!-- AMCL — localizes the robot on the real field map.
       No hardcoded initial_pose: robot position is unknown on startup.
       Use "2D Pose Estimate" in RViz to give AMCL a starting hint if needed.
       Higher particle counts than simulation — real sensor noise requires more hypotheses. -->
<node pkg="amcl" type="amcl" name="amcl" output="screen" >
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="global_frame_id" value="map"/>
    <!-- Use corrected scan topic from scan_relay — NOT raw /scan -->
    <param name="scan_topic" value="/scan_fixed"/>
    <!-- Particle count — increased after observing scan/map drift during navigation.
         More particles = more hypotheses = better tracking in motion.
         5000 max gives AMCL room to spread during uncertain motion segments.
         Monitor CPU with htop — reduce max_particles if move_base loop slows down. -->
    <param name="min_particles" value="500"/>
    <param name="max_particles" value="2000"/>

    <!-- Odometry noise — tightened from 0.5/0.5/0.3/0.3 to trust encoders more.
         The hallway has a smooth floor and the Husky's wheel encoders are fairly
         accurate. Tighter alphas keep the particle cloud focused during motion,
         reducing the smearing that causes scan/map misalignment at speed. -->
    <param name="odom_model_type" value="diff"/>
    <param name="odom_alpha1" value="0.2"/>
    <param name="odom_alpha2" value="0.2"/>
    <param name="odom_alpha3" value="0.1"/>
    <param name="odom_alpha4" value="0.1"/>

    <!-- Laser model — increased beams from 60 to 180 for better scan matching.
         More beams give the likelihood model more data points to align against
         the map, producing more confident resampling during motion. -->
    <param name="laser_max_range" value="12.0"/>
    <param name="laser_max_beams" value="180"/>
    <param name="laser_z_hit" value="0.90"/>
    <param name="laser_z_rand" value="0.10"/>

    <!-- Update thresholds set to 0 — forces AMCL to process every scan and
         publish the map->odom TF continuously. Without this, AMCL only updates
         when the robot moves 0.1m or rotates 0.1rad. If the robot pauses even
         briefly, the TF goes stale after ~1 second and the costmap times out,
         causing "Costmap2DROS transform timeout" and extrapolation errors. -->
    <!-- Update thresholds: only resample when robot actually moves.
         0.0/0.0 caused drift while stationary — odometry noise fed into
         motion model every scan cycle, walking particles away from true pose. -->
    <param name="update_min_d" value="0.05"/>
    <param name="update_min_a" value="0.1"/>

    <!-- Transform tolerance — real hardware runs at full RTF (1.0) so default is fine.
         Increase to 0.5 if you see "transform too old" warnings. -->
    <param name="transform_tolerance" value="1"/>

    <!-- No hardcoded initial_pose — use global_localization + manual driving to localize.
         (0,0) on hallway_strip is off the map edge and causes immediate AMCL failure.) -->

  </node>


  <!-- move_base — global + local planner, drives to goals.
       Same config files as simulation; speed params may need tuning. -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find husky_custom_sim)/config/costmap_common.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find husky_custom_sim)/config/costmap_common.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find husky_custom_sim)/config/global_costmap.yaml"
              command="load"/>
    <rosparam file="$(find husky_custom_sim)/config/local_costmap.yaml"
              command="load"/>
    <rosparam file="$(find husky_custom_sim)/config/move_base_params.yaml"
              command="load"/>

    <!-- Real robot: send through twist_mux, NOT directly to controller.
         twist_mux manages priority between navigation, teleop, and e-stop. -->
    <remap from="cmd_vel" to="/cmd_vel"/>
  </node>

</launch>
