<launch>
  <!--
    Real Robot Navigation Launch File
    Localizes using slam_toolbox localization mode on a saved serialized map,
    then navigates to goals via move_base.

    Prerequisites:
      - hallway_map_slam_test.posegraph + .data must exist in maps/
        (generated by: rosservice call /slam_toolbox/serialize_map "filename: '...hallway_map_slam_test'")
      - Husky powered on, e-stop released, base drivers running
      - VLP-16 publishing at ~10 Hz (rostopic hz /velodyne_points)
      - This launch file runs ON THE ROBOT (x86 PC) over SSH

    Usage:
      1. SSH into robot: ssh administrator@<robot_ip>
      2. source ~/catkin_ws/devel/setup.bash
      3. roslaunch husky_custom_sim husky_real_nav.launch
      4. rosrun husky_custom_sim navigate.py   (second terminal)
  -->

  <param name="/use_sim_time" value="false"/>

  <!-- scan_relay: corrects VLP-16 /scan header mismatch (897 vs 898 readings).
       Publishes corrected scan to /scan_fixed for both slam_toolbox and costmap. -->
  <node pkg="husky_custom_sim" type="scan_relay.py" name="scan_relay" output="screen"/>

  <!-- slam_toolbox in localization mode.
       Replaces AMCL — uses direct scan matching against the serialized map
       instead of a particle filter. More robust in symmetric corridors because
       it finds the mathematically best scan alignment rather than voting across
       hundreds of particles that can flip 180 degrees in a featureless hallway.
       Publishes the same map->odom TF that move_base expects. -->
  <node pkg="slam_toolbox" type="localization_slam_toolbox_node" name="slam_toolbox"
        output="screen" launch-prefix="nice -n 5">
    <rosparam file="$(find husky_custom_sim)/config/slam_toolbox_localization_params.yaml"
              command="load"/>
    <!-- Tell slam_toolbox which serialized map to localize against -->
    <param name="map_file_name"
           value="/home/administrator/HuskyRealWork/src/husky_custom_sim/maps/hallway_map_slam_test"/>
    <param name="map_start_at_dock" value="true"/>
  </node>

  <!-- map_server: publishes the PGM map for move_base costmaps and Foxglove display.
       slam_toolbox localization handles the TF — map_server just provides the occupancy grid. -->
  <node pkg="map_server" type="map_server" name="map_server"
        args="$(find husky_custom_sim)/maps/hallway_map_slam_test.yaml"/>

  <!-- move_base — global + local planner, drives to goals.
       Unchanged from before — localization source is transparent to move_base. -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find husky_custom_sim)/config/costmap_common.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find husky_custom_sim)/config/costmap_common.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find husky_custom_sim)/config/global_costmap.yaml"
              command="load"/>
    <rosparam file="$(find husky_custom_sim)/config/local_costmap.yaml"
              command="load"/>
    <rosparam file="$(find husky_custom_sim)/config/move_base_params.yaml"
              command="load"/>
    <remap from="cmd_vel" to="/cmd_vel"/>
  </node>

</launch>
