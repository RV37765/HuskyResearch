<launch>
  <!--
    Crop Row SLAM Launch File
    Starts Gazebo with crop row field + Husky + SLAM + RViz + keyboard teleop.
    Drive the robot between crop rows while SLAM builds a map.
    Use i/j/k/l keys to drive. Save map with:
      rosrun map_server map_saver -f ~/catkin_ws/crop_map
  -->

  <param name="/use_sim_time" value="true"/>

  <!-- Start Gazebo with crop row world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find husky_custom_sim)/crop_row.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
  </include>

  <!-- Spawn the Husky robot 2m before the rows start.
       Rows begin at X=0. Spawning at X=-2 gives a clear straight approach
       into the aisle rather than starting surrounded by plants. -->
  <include file="$(find husky_gazebo)/launch/spawn_husky.launch">
    <arg name="x" value="-2.0"/>
    <arg name="y" value="0.0"/>
    <arg name="z" value="0.0"/>
    <arg name="yaw" value="0.0"/>
  </include>

  <!-- Re-spawn controllers with a longer timeout.
       WSL2 is slow — Gazebo takes ~60s to load the world, but the default
       controller spawner (from spawn_husky.launch) gives up after 30s.
       This node waits up to 120s so the controller always loads automatically. -->
  <node name="controller_respawner" pkg="controller_manager" type="spawner"
        args="--timeout 120 husky_joint_publisher husky_velocity_controller"
        output="screen"/>

  <!-- Static TF: base_link to velodyne (sensor is 0.4m above robot center) -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_velodyne"
        args="0 0 0.4 0 0 0 base_link velodyne 100"/>

  <!-- Convert Velodyne 3D point cloud to 2D laser scan -->
  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan" output="screen">
    <remap from="cloud_in" to="/velodyne_points"/>
    <remap from="scan" to="/scan"/>
    <param name="target_frame" value="base_link"/>
    <!-- Height filter in base_link frame. base_link is ~0.13m above ground.
         min 0.05: exclude ground returns (ground is at -0.13 in base_link).
         max 0.6: plants are 0.6m tall, Velodyne at 0.4m — captures plant
         bodies cleanly without picking up sky or excessive noise above. -->
    <param name="min_height" value="0.05"/>
    <param name="max_height" value="0.6"/>
    <param name="range_min" value="0.2"/>
    <param name="range_max" value="15.0"/>
  </node>

  <!-- SLAM Toolbox -->
  <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <rosparam file="$(find husky_custom_sim)/config/slam_toolbox_params.yaml" command="load"/>
  </node>

  <!-- RViz with map view -->
  <node pkg="rviz" type="rviz" name="rviz" output="screen"
        args="-d $(find husky_custom_sim)/config/slam_view.rviz"/>

  <!-- Keyboard teleop (i/j/k/l to drive) -->
  <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" name="teleop"
        output="screen" launch-prefix="xterm -fa 'Monospace' -fs 10 -e">
    <remap from="cmd_vel" to="/joy_teleop/cmd_vel"/>
  </node>

</launch>