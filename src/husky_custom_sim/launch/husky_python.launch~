<launch>
  <!-- Launch Husky in Gazebo -->
  <include file="$(find husky_gazebo)/launch/husky_playpen.launch">
    <arg name="world_name" value="$(find husky_gazebo)/worlds/row_playpen.world"/>
  </include>

  <!-- RViz visualization -->
  <include file="$(find husky_viz)/launch/view_robot.launch"/>

  <!-- Python obstacle avoidance node -->
  <node pkg="obstacle_avoidance" type="husky_controller.py" name="husky_controller" output="screen"/>
</launch>
