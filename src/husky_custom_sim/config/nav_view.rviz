Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
    - Class: rviz/Map
      Name: Static Map
      Enabled: true
      Topic: /map
      Color Scheme: map
      Draw Behind: true
    - Class: rviz/Map
      Name: Global Costmap
      Enabled: true
      Topic: /move_base/global_costmap/costmap
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz/Map
      Name: Local Costmap
      Enabled: true
      Topic: /move_base/local_costmap/costmap
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Queue Size: 10
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/Path
      Name: Global Plan
      Enabled: true
      Topic: /move_base/NavfnROS/plan
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz/Path
      Name: Local Plan
      Enabled: true
      Topic: /move_base/DWAPlannerROS/local_plan
      Color: 0; 0; 255
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/TF
      Name: TF
      Enabled: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: TopDownOrtho
      Scale: 30
      X: 0
      Y: 0
