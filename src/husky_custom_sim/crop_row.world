<sdf version='1.7'>
  <world name='crop_field'>

    <!-- Lighting -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane — brown soil color -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.45 0.30 0.10 1</ambient>
            <diffuse>0.50 0.35 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.6 0.8 0.5 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- Overhead camera — wide enough to see full 6-row field -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>6.5 0 22 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!--
      CROP ROW LAYOUT (v4 — cotton plant visuals)
      =============================================
      6 rows × 20 plants.  Row spacing 2.0m.  Plant spacing 0.7m.
      Field length: X = 0.0 to 13.3m.  Robot spawns at X=-2.0, Y=0.0.

      Row Y positions:   -5.0  -3.0  -1.0  +1.0  +3.0  +5.0
      Aisle Y positions: -4.0  -2.0   0.0  +2.0  +4.0
      Robot center aisle: Y=0.0 (between rows 3 and 4)

      PLANT GEOMETRY (per plant, one SDF model):
        - <collision>  : thin cylinder, radius 0.05m, height 0.8m
                         This is ALL the LiDAR sees. Clean, consistent returns.
        - <visual stem>: thinner cylinder, radius 0.03m, height 0.55m
                         Represents the cotton stalk (lower plant body).
        - <visual canopy>: sphere, radius 0.25m, centered at Z=0.675 absolute
                         Represents the cotton plant canopy / bolls.
                         LiDAR DOES NOT hit this — it is visual only.

      Why separate collision/visual?
        The LiDAR scans reflect off collision geometry only. Using a thin
        collision cylinder (0.05m) produces clean, repeatable scan returns
        that slam_toolbox and AMCL can work with reliably. The spherical
        canopy is purely for visual realism and matches cotton plant
        proportions (1.0m tall, 0.7m wide per CottonSim specifications).

      BOUNDARY WALLS:
        Side walls at Y=±6.5 and end wall at X=14.5.
        These give AMCL unique reference features in a symmetric field.
        Without them, all 5 aisles look identical — AMCL cannot determine
        which aisle the robot is in. The walls are visible in the SLAM map
        and allow the localizer to distinguish field position reliably.
    -->

    <!-- ==================== ROW 1 (y = -5.0) ==================== -->
    <model name='row1_plant_00'><static>1</static><link name='link'><collision name='c'><geometry><cylinder><radius>0.05</radius><length>0.8</length></cylinder></geometry></collision><visual name='stem'><pose>0 0 -0.125 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>0.55</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual><visual name='canopy'><pose>0 0 0.275 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>0.0 -5.0 0.4 0 0 0</pose></model>
    <model name='row1_plant_01'><static>1</static><link name='link'><collision name='c'><geometry><cylinder><radius>0.05</radius><length>0.8</length></cylinder></geometry></collision><visual name='stem'><pose>0 0 -0.125 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>0.55</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual><visual name='canopy'><pose>0 0 0.275 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>0.7 -5.0 0.4 0 0 0</pose></model>
