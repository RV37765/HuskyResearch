<sdf version='1.7'>
  <world name='crop_field'>
    <!-- Lighting -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.85 1.0 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- Overhead camera so Gazebo opens looking straight down at the field -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>3.5 0 20 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!--
      CROP ROW LAYOUT (v2 — wider aisles)
      =====================================
      4 rows of "plants" running along the X axis.
      Each row is 7.0m long (15 plants at 0.5m spacing, X: 0.0 to 7.0).
      Rows spaced 2.0m apart in Y — up from 1.5m — giving 1.32m clear aisle
      (2.0m - 0.68m Husky width = 1.32m clearance, ~0.66m per side).

      Plants are 0.075m radius, 0.6m tall cylinders (taller = better LiDAR target).
      Plant center Z = 0.3m (half of 0.6m height).

      Row positions (Y coordinates):
        Row 1: y = -3.0
        Row 2: y = -1.0
        Row 3: y =  1.0
        Row 4: y =  3.0

      Aisles:
        Outer left:  y < -3.0
        Aisle 1:     y = -2.0  (between rows 1 and 2)
        Aisle 2:     y =  0.0  (between rows 2 and 3) <- robot drives here
        Aisle 3:     y =  2.0  (between rows 3 and 4)
        Outer right: y >  3.0

      Robot spawns at x = -2.0, y = 0.0 — 2m before the first plant,
      giving a clean straight approach into aisle 2 along the +X direction.
    -->

    <!-- ==================== ROW 1 (y = -3.0) ==================== -->
    <model name='row1_plant_00'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>0.0 -3.0 0.3 0 0 0</pose></model>
    <model name='row1_plant_01'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>0.5 -3.0 0.3 0 0 0</pose></model>
    <model name='row1_plant_02'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>1.0 -3.0 0.3 0 0 0</pose></model>
    <model name='row1_plant_03'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>1.5 -3.0 0.3 0 0 0</pose></model>
    <model name='row1_plant_04'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>2.0 -3.0 0.3 0 0 0</pose></model>
    <model name='row1_plant_05'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.6</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>2.5 -3.0 0.3 0 0 0</pose></model>
