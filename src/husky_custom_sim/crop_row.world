<sdf version='1.7'>
  <world name='crop_field'>
    <!-- Lighting -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.85 1.0 1</background>
      <shadows>1</shadows>
    </scene>

    <!--
      CROP ROW LAYOUT
      ===============
      4 rows of "plants" running along the X axis (east-west)
      Each row is 7.5m long (15 plants at 0.5m spacing)
      Rows spaced 1.5m apart in Y
      Plants are 0.15m diameter cylinders, 0.4m tall

      Row positions (Y coordinates):
        Row 1: y = -2.25
        Row 2: y = -0.75
        Row 3: y =  0.75
        Row 4: y =  2.25

      Row X range: 0.0 to 7.0 (15 plants)
      Robot spawn: x=0, y=0 (in the aisle between rows 2 and 3)

      Aisles:
        Aisle 1: between row 1 and row 2 (center y = -1.5)
        Aisle 2: between row 2 and row 3 (center y =  0.0) <- robot starts here
        Aisle 3: between row 3 and row 4 (center y =  1.5)

      Aisle width = 1.5m - 0.15m (plant diameter) = 1.35m clear
      Husky width = 0.68m, so ~0.34m clearance on each side
    -->

    <!-- ==================== ROW 1 (y = -2.25) ==================== -->
    <model name='row1_plant_00'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>0.0 -2.25 0.2 0 0 0</pose></model>
    <model name='row1_plant_01'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>0.5 -2.25 0.2 0 0 0</pose></model>
    <model name='row1_plant_02'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>1.0 -2.25 0.2 0 0 0</pose></model>
    <model name='row1_plant_03'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>1.5 -2.25 0.2 0 0 0</pose></model>
    <model name='row1_plant_04'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry></collision><visual name='visual'><geometry><cylinder><radius>0.075</radius><length>0.4</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link><pose>2.0 -2.25 0.2 0 0 0</pose></model>
